# ==============================================================================
# MediPulse Environment Configuration
# Copy this file to .env and configure your local credentials.
# NEVER commit your actual .env file or API keys to Git!
# ==============================================================================

# Primary AI Model: Google Gemma (via Google GenAI SDK / Gemini API)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma Model Selection (Default: gemma-4-26b-a4b-it)
# Supported options: gemma-4-26b-a4b-it, gemma-4-31b-it, etc.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional APIM or Custom OpenAI-Compatible Base URL hosting Gemma
# GEMMA_ENDPOINT=https://your-apim-gateway.azure-api.net/v1

# Optional Tavily API Key for live medical authority web search
# Get your free key from: https://tavily.com
# If omitted, MediPulse automatically uses the built-in authoritative WHO/CDC/NIH clinical registry.
TAVILY_API_KEY=

# Flask Application Secret Key (generate a random 32-character string for production)
FLASK_SECRET_KEY=replace_with_a_secure_random_secret_key_here

# Server Configuration
PORT=5000
FLASK_DEBUG=0
REQUEST_TIMEOUT=25

# Offline / Mock AI Mode (Set to true to force deterministic mock responses without using API credits)
# Note: If GEMINI_API_KEY is not provided, MediPulse automatically runs in mock mode so you can test immediately!
MOCK_AI=false
